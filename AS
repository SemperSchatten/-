    """Bloch-Kugel Implementierung für Qubit-Visualisierung"""
    
    def __init__(self):
        self.theta = 0.0  # Polarwinkel
        self.phi = 0.0    # Azimutwinkel
        self.fig = None
        self.ax = None
        
    def set_state(self, theta: float, phi: float):
        """Setzt den Quantenzustand auf der Bloch-Kugel"""
        self.theta = theta
        self.phi = phi
        
    def get_cartesian_coordinates(self) -> tuple:
        """Konvertiert Kugelkoordinaten zu kartesischen Koordinaten"""
        x = np.sin(self.theta) * np.cos(self.phi)
        y = np.sin(self.theta) * np.sin(self.phi)
        z = np.cos(self.theta)
        return x, y, z
        
    def get_quantum_state(self) -> complex:
        """Berechnet den Quantenzustand |ψ⟩ = cos(θ/2)|0⟩ + e^(iφ)sin(θ/2)|1⟩"""
        alpha = np.cos(self.theta / 2)
        beta = np.exp(1j * self.phi) * np.sin(self.theta / 2)
        return alpha, beta
        
    def evolve_state(self, dt: float = 0.1):
        """Zeitentwicklung des Quantenzustands"""
        # Simuliere Präzession um z-Achse
        omega = 2.0  # Präzessionsfrequenz
        self.phi += omega * dt
        self.phi = self.phi % (2 * np.pi)
        
        # Leichte Dämpfung
        self.theta += 0.01 * np.sin(self.phi)
        
    def visualize(self) -> Dict[str, Any]:
        """Erstellt Visualisierungsdaten für die Bloch-Kugel"""
        x, y, z = self.get_cartesian_coordinates()
        alpha, beta = self.get_quantum_state()
        
        return {
            'position': {'x': x, 'y': y, 'z': z},
            'theta': self.theta,
            'phi': self.phi,
            'quantum_state': {
                'alpha': {'real': alpha.real, 'imag': alpha.imag},
                'beta': {'real': beta.real, 'imag': beta.imag}
            },
            'probability_0': abs(alpha)**2,
            'probability_1': abs(beta)**2
        }

