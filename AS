    def __init__(self, sample_rate: int = 44100, duration: float = 1.0):
        self.sample_rate = sample_rate
        self.duration = duration
        self.t = np.linspace(0, duration, int(sample_rate * duration))
        
        # WEB-Physik Konstanten
        self.elementary_charge = 1.602176634e-19  # e
        self.speed_of_light = 299792458  # c in m/s
        self.planck_constant = 6.62607015e-34  # h
        
        # Quantengate Parameter
