  class WaveFunctionSimulator:
      """
      Simulator für Quantenwellenfunktionen und ihre zeitliche Entwicklung.
      """
      def __init__(self, time_scale=1.0, decay_rate=10.0):          """
          Initialisiert den Wellenfunktionssimulator.
         
          Args:
              time_scale (float): Zeitskala für die Simulation
              decay_rate (float): Zerfallsrate der Wellenfunktion
          """
          self.time_scale = time_scale
          self.decay_rate = decay_rate
     
      def generate_wave_data(self, t_max=10, step=0.1):
          """
          Generiert Wellenfunktionsdaten über die Zeit.
         
          Args:
              t_max (float): Maximale Zeit
              step (float): Zeitschritt
             
          Returns:
              dict: Wellenfunktionsdaten
          """
          t = np.arange(0, t_max, step)
         
          # Realteil der Wellenfunktion
          real_part = np.cos(self.time_scale * t) * np.exp(-t / self.decay_rate)
         
          # Imaginärteil der Wellenfunktion
          imag_part = np.sin(self.time_scale * t) * np.exp(-t / self.decay_rate)
         
          # Wahrscheinlichkeitsdichte
          probability = real_part**2 + imag_part**2
         
          # Daten für die Visualisierung
          data = []
          for i, ti in enumerate(t):
              data.append({
                  'time': ti,
                  'realPart': real_part[i],
                  'imagPart': imag_part[i],
                  'probability': probability[i]
              })
         
          return {
              'data': data,
              'time_scale': self.time_scale,
              'decay_rate': self.decay_rate,
              'parameters': {
                  't_max': t_max,
                  'step': step
              }
          }
     
      def modified_schrodinger_equation(self, x, V0=0, k=1):
          """
          Berechnet eine Lösung der modifizierten Schrödinger-Gleichung.
         
          Args:
              x (ndarray): Raumkoordinaten
              V0 (float): Potentialhöhe
              k (float): Wellenzahl
             
          Returns:
              tuple: Realteil, Imaginärteil, Wahrscheinlichkeit
          """
          # Vereinfachte Lösung für ein freies Teilchen
          real_part = np.cos(k * x) * np.exp(-V0 * x**2)
          imag_part = np.sin(k * x) * np.exp(-V0 * x**2)
          probability = real_part**2 + imag_part**2
         
          return real_part, imag_part, probability
     
      def simulate_wavefunction_collapse(self, num_steps=10, measurements=5):
          """
          Simuliert den Kollaps einer Wellenfunktion durch mehrere Messungen.
         
          Args:
              num_steps (int): Anzahl der Simulationsschritte
              measurements (int): Anzahl der Messungen
             
          Returns:
              dict: Simulationsergebnisse
          """
          x = np.linspace(-5, 5, 100)
         
          # Ursprüngliche Wellenfunktion (Gaußsches Wellenpaket)
          initial_real, initial_imag, initial_prob = self.modified_schrodinger_equation(x)
         
          # Ergebnisse für jede Messung
          results = []
         
          # Ursprünglicher Zustand
          results.append({
              'x': x.tolist(),
              'real': initial_real.tolist(),
              'imag': initial_imag.tolist(),
              'probability': initial_prob.tolist(),
              'step': 0,
              'measured': False
          })
         
          # Aktuelle Wellenfunktion (wird durch Messungen verändert)
          current_real = initial_real.copy()
          current_imag = initial_imag.copy()
         
          for i in range(1, num_steps):
              # Simuliere Zeitentwicklung (vereinfacht)
              current_real = np.cos(0.2 * i) * current_real - np.sin(0.2 * i) * current_imag
              current_imag = np.sin(0.2 * i) * current_real + np.cos(0.2 * i) * current_imag
             
              # Aktuelle Wahrscheinlichkeitsdichte
              current_prob = current_real**2 + current_imag**2
             
              # Normalisierung
              norm = np.sqrt(np.sum(current_prob))
              if norm > 1e-10:
                  current_real /= norm
                  current_imag /= norm
                  current_prob /= norm
             
              # Speichere Ergebnis
              measured = (i % (num_steps // measurements) == 0) and (i > 0)
             
              results.append({
                  'x': x.tolist(),
                  'real': current_real.tolist(),
                  'imag': current_imag.tolist(),
                  'probability': current_prob.tolist(),
                  'step': i,
                  'measured': measured
              })
             
              # Wenn gemessen wurde, Wellenfunktion kollabieren lassen
              if measured:
                  # Simuliere Messung durch Verschmälerung der Wahrscheinlichkeitsverteilung
                  # um einen zufälligen Punkt
                  peak_index = np.random.choice(len(x), p=current_prob/np.sum(current_prob))
                 
                  # Neues Gaußsches Wellenpaket um den gemessenen Wert
                  sigma = 0.5 # Schmaler als das ursprüngliche Paket
                  gaussian = np.exp(-(x - x[peak_index])**2 / (2 * sigma**2))
                  gaussian /= np.sqrt(np.sum(gaussian**2))
                 
                  # Aktualisiere die Wellenfunktion
                  phase = np.arctan2(current_imag[peak_index], current_real[peak_index])
                  current_real = np.cos(phase) * gaussian
                  current_imag = np.sin(phase) * gaussian
         
          return {
              'results': results,
              'description': "Simulation des Wellenfunktionskollapses durch mehrere Messungen"
          }
 
 
