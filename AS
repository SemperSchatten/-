          """
          Generiert Daten für die Interaktion zwischen den Domänen.
         
          Args:
              num_points (int): Anzahl der Datenpunkte
              interaction_strength (float): Stärke der Interaktion (0-1)
             
          Returns:
              dict: Interaktionsdaten
          """
          t = np.linspace(0, 10, num_points)
         
          # Basisfunktionen für jede Domäne
          classical_base = np.cos(t) * np.exp(-t/15)
          quantum_base = np.sin(t * 2) * np.exp(-t/12)
          information_base = np.sin(t/2) * np.cos(t) * np.exp(-t/10)
         
          # Interaktionsterme
          c_q_interaction = interaction_strength * np.sin(t * 3) * np.exp(-t/20)
          c_i_interaction = interaction_strength * np.cos(t * 2) * np.exp(-t/18)
          q_i_interaction = interaction_strength * np.sin(t * 1.5) * np.exp(-t/25)
         
          # Kombinierte Funktionen mit Interaktionen
          classical = classical_base + c_q_interaction + c_i_interaction
          quantum = quantum_base + c_q_interaction + q_i_interaction
          information = information_base + c_i_interaction + q_i_interaction
         
          # Gesamtsystem (emergente Eigenschaften)
          unified = (classical + quantum + information) / 3
         
          # Daten als Liste von Objekten
          data = []
